# ─── LLM ───────────────────────────────────────────────
# GPT-4o 급 모델 API 키. 실제 값은 .env 에만 넣고 절대 커밋하지 않는다.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ─── Database ──────────────────────────────────────────
POSTGRES_DB=ptech
POSTGRES_USER=ptech
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Django ────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── RAG 검색 파라미터 (specs/05-rag-pipeline.md 기준) ──
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.4
RAG_SEMANTIC_WEIGHT=0.6
RAG_KEYWORD_WEIGHT=0.4

# ─── Frontend (Vite) ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
